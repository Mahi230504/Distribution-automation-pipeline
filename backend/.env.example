PORT=4000
TEST_MODE=true
GEMINI_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_SCORING=gemini-3.5-flash-lite
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
GEMINI_MAX_CONCURRENT_CALLS=2
GEMINI_RETRY_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=1000
SPEAKING_RATE=2.5
RESEARCH_CACHE_HOURS=24
STORAGE_LOCAL_PATH=./data
TEST_DELAY_MS=350
MAIN_INPUT_PRICE=0.75
MAIN_OUTPUT_PRICE=3.75
SCORING_INPUT_PRICE=0.30
SCORING_OUTPUT_PRICE=2.50
IMAGE_PRICE=0.067
SEARCH_REQUEST_PRICE=0.014

IMAGE_INPUT_PRICE=0.5
IMAGE_TEXT_OUTPUT_PRICE=3
PROMPT_QUALITY_THRESHOLD=75
PROMPT_REWRITE_LIMIT=2
FRAME_QUALITY_THRESHOLD=70
FRAME_AUTO_REGENERATION_LIMIT=1
MANUAL_REGENERATION_LIMIT=6
MAX_TOTAL_FRAMES=6
UPLOAD_SIZE_LIMIT_BYTES=5242880

# Parallel source-page requests, separate from Gemini call limits (1–6).
SOURCE_FETCH_CONCURRENCY=3
