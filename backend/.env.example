PORT=4000
TEST_MODE=true
# Publishing mode is independent from AI TEST_MODE. Keep test unless a later
# controlled live-platform validation is explicitly authorized.
PUBLISH_MODE=test
PUBLIC_OAUTH_CALLBACK_BASE_URL=http://localhost:4000
# LIVE only: JSON object whose values are base64-encoded 32-byte AES keys.
PLATFORM_TOKEN_KEYS_JSON=
PLATFORM_TOKEN_ACTIVE_KEY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
PROVIDER_TIMEOUT_MS=30000
PROVIDER_RESPONSE_LIMIT_BYTES=1048576
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_MS=30000
MEDIA_PROBE_CONCURRENCY=2
MEDIA_PROBE_STDOUT_LIMIT_BYTES=2000000
MEDIA_PROBE_STDERR_LIMIT_BYTES=65536
PACK_INPUT_TOKEN_ALLOWANCE=16000
PACK_OUTPUT_TOKEN_ALLOWANCE=6000
# Ownership mode is independent from TEST_MODE. Supported runtime pairs only:
# local + local_json, or supabase + supabase.
AUTH_MODE=local
STORAGE_MODE=local_json
GEMINI_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_SCORING=gemini-3.5-flash-lite
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
GEMINI_MAX_CONCURRENT_CALLS=2
GEMINI_RETRY_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=1000
SPEAKING_RATE=2.5
RESEARCH_CACHE_HOURS=24
STORAGE_LOCAL_PATH=./data
# Required only for Supabase mode. Publishable verifies user JWTs; secret is
# server-only and bypasses RLS, so it must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TEST_DELAY_MS=350
MAIN_INPUT_PRICE=0.75
MAIN_OUTPUT_PRICE=3.75
SCORING_INPUT_PRICE=0.30
SCORING_OUTPUT_PRICE=2.50
IMAGE_PRICE=0.067
SEARCH_REQUEST_PRICE=0.014

IMAGE_INPUT_PRICE=0.5
IMAGE_TEXT_OUTPUT_PRICE=3
PROMPT_QUALITY_THRESHOLD=75
PROMPT_REWRITE_LIMIT=2
FRAME_QUALITY_THRESHOLD=70
FRAME_AUTO_REGENERATION_LIMIT=1
MANUAL_REGENERATION_LIMIT=6
MAX_TOTAL_FRAMES=6
UPLOAD_SIZE_LIMIT_BYTES=5242880

# Parallel source-page requests, separate from Gemini call limits (1–6).
SOURCE_FETCH_CONCURRENCY=3
