# Address of the backend API. Development can leave this unset to run against
# labelled sample data. A production build requires all four public values.
# NEXT_PUBLIC_API_URL=http://localhost:4000
# Match the configured backend. Use local for the offline fixture identity or
# supabase for real sign-in. A configured Supabase mode never falls back.
NEXT_PUBLIC_AUTH_MODE=local

# Added from step 5 onward, once Supabase sign-in is wired up.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
